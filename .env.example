# Supabase — used for contact form / legacy waitlist submissions
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON=your-anon-public-key

# ClearWork API — must include /api/v1 (NOT the landing domain)
# Local dev:  http://localhost:3000/api/v1
# Production: https://rupway-backend.fly.dev/api/v1
VITE_API_URL=https://rupway-backend.fly.dev/api/v1

# Analytics — get from analytics.google.com → Admin → Data Streams → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
