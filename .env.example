# Supabase — used for contact form / legacy waitlist submissions
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON=your-anon-public-key

# ClearWork API — used for platform stats (user count)
VITE_API_URL=https://rupway-backend.fly.dev

# Analytics — get from analytics.google.com → Admin → Data Streams → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
