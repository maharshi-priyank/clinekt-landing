{
  "env": {
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
    "VITE_API_URL": "https://rupway-backend.fly.dev/api/v1"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.getclearwork.in" }],
      "destination": "https://getclearwork.in/:path*",
      "permanent": true
    },
    {
      "source": "/honeybook-alternative",
      "destination": "/alternatives/honeybook-alternative-india",
      "permanent": true
    },
    {
      "source": "/bonsai-alternative",
      "destination": "/alternatives/bonsai-alternative-india",
      "permanent": true
    },
    {
      "source": "/dubsado-alternative",
      "destination": "/alternatives/dubsado-alternative-india",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/",                                    "destination": "/index.html" },
    { "source": "/tools",                               "destination": "/index.html" },
    { "source": "/tools/gst-invoice-generator",         "destination": "/index.html" },
    { "source": "/tools/gst-calculator",                "destination": "/index.html" },
    { "source": "/tools/tds-calculator",                "destination": "/index.html" },
    { "source": "/tools/hourly-rate-calculator",        "destination": "/index.html" },
    { "source": "/tools/income-tax-calculator",         "destination": "/index.html" },
    { "source": "/tools/freelance-contract-generator",  "destination": "/index.html" },
    { "source": "/tools/quote-generator",               "destination": "/index.html" },
    { "source": "/tools/invoice-number-generator",      "destination": "/index.html" },
    { "source": "/security",                            "destination": "/index.html" },
    { "source": "/features",                            "destination": "/index.html" },
    { "source": "/e-signature-software",                "destination": "/index.html" },
    { "source": "/crm-for-small-business",               "destination": "/index.html" },
    { "source": "/contract-management-software",         "destination": "/index.html" },
    { "source": "/alternatives",                        "destination": "/index.html" },
    { "source": "/alternatives/honeybook-alternative-india", "destination": "/index.html" },
    { "source": "/alternatives/bonsai-alternative-india",  "destination": "/index.html" },
    { "source": "/alternatives/dubsado-alternative-india", "destination": "/index.html" },
    { "source": "/software-for-service-businesses",     "destination": "/index.html" },
    { "source": "/software-for-consultants",            "destination": "/index.html" },
    { "source": "/crm-for-marketing-agencies",          "destination": "/index.html" },
    { "source": "/software-for-agencies",               "destination": "/index.html" },
    { "source": "/blog",                                "destination": "/index.html" },
    { "source": "/blog/how-to-create-gst-invoice-india",          "destination": "/index.html" },
    { "source": "/blog/is-e-signature-legal-india",               "destination": "/index.html" },
    { "source": "/blog/tds-on-freelance-income-194j-194c-india",  "destination": "/index.html" },
    { "source": "/blog/how-to-write-freelance-contract-india",    "destination": "/index.html" },
    { "source": "/blog/old-vs-new-tax-regime-freelancer-india",   "destination": "/index.html" },
    { "source": "/blog/honeybook-alternative-india",                    "destination": "/index.html" },
    { "source": "/blog/bonsai-alternative-india",                       "destination": "/index.html" },
    { "source": "/blog/dubsado-alternative-india",                      "destination": "/index.html" },
    { "source": "/blog/refrens-alternative-india",                      "destination": "/index.html" },
    { "source": "/blog/honeybook-bonsai-dubsado-alternative-india",     "destination": "/index.html" },
    { "source": "/blog/best-freelancer-software-india-2026",            "destination": "/index.html" },
    { "source": "/blog/how-to-write-freelance-proposal-india",          "destination": "/index.html" },
    { "source": "/blog/freelancer-client-follow-up-india",              "destination": "/index.html" },
    { "source": "/blog/gst-for-freelancers-india-complete-guide",       "destination": "/index.html" },
    { "source": "/blog/how-to-get-freelance-clients-india",             "destination": "/index.html" },
    { "source": "/blog/retainer-vs-project-pricing-agencies-india",     "destination": "/index.html" },
    { "source": "/blog/freelance-invoice-format-india",                 "destination": "/index.html" },
    { "source": "/blog/gst-number-format-explained",                    "destination": "/index.html" },
    { "source": "/pricing",                                             "destination": "/index.html" },
    { "source": "/about",                                               "destination": "/index.html" },
    { "source": "/contact",                                             "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ]
}
